localhost {
    handle_path /media/* {
        rewrite * {path}
        reverse_proxy storage:3902 {
            header_up Host media.web.garage.localhost
        }
    }

    handle /api/* {
        reverse_proxy api:8080
    }

    handle {
        reverse_proxy api:8080
        root * /srv/web
        try_files {path} /index.html
        file_server
    }
}